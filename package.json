{
  "name": "contratos-limtek",
  "version": "1.5.2",
  "description": "Generador de Contratos y Compromisos - Limtek",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "docxtemplater": "^3.50.0",
    "electron-updater": "^6.8.3",
    "pizzip": "^3.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^30.5.1",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.60.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.limtek.contratos",
    "productName": "Contratos Limtek",
    "publish": {
      "provider": "github",
      "owner": "OdenDeshi-oss",
      "repo": "contratos-limtek"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
