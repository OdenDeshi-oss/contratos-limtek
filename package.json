{
  "name": "contratos-limtek",
  "version": "2.0.0",
  "description": "Gestión Integral de Contratos - Limtek (generar, renombrar y buscar contratos)",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "test": "node --test --no-warnings \"tests/*.test.mjs\""
  },
  "dependencies": {
    "docxtemplater": "^3.50.0",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pizzip": "^3.1.7",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^30.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.60.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.limtek.contratos",
    "productName": "Contratos Limtek",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "OdenDeshi-oss",
      "repo": "contratos-limtek",
      "releaseType": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ]
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true
  }
}
